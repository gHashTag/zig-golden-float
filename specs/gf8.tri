# GF8 Format Specification (Source of Truth)
# 8-bit φ-optimized floating-point format for edge inference
# Level 0 + Level 1: Format + Operations

format: GF8
version: 1
level: 1

storage:
  bits: 8
  align_bytes: 1
  endianness: little
  underlying: u8

fields:
  - name: sign
    bits: 1
    position_msb: 7
  - name: exponent
    bits: 3
    position_msb: 6
  - name: mantissa
    bits: 4
    position_msb: 5

exponent:
  bits: 3
  bias: 7
  max: 15
  min: 0
  special:
    zero:
      exponent: 0
      mantissa: 0
    inf:
      exponent: 15
      mantissa: 0
    nan:
      exponent: 15
      mantissa_nonzero: true

rounding:
  mode: ties-to-even
  source_type: f32
  overflow_policy: saturate_to_inf
  underflow_policy: subnormal_then_zero

phi:
  total_bits: 7
  exponent_bits: 3
  mantissa_bits: 4
  target_ratio: 0.6180339
  ratio: 0.5714286
  distance: 0.0465953

abi:
  zig:
    typename: u8
  rust:
    typename: u8
  c:
    typename: uint8_t
  cpp:
    typename: uint8_t

conversion:
  from_f32_steps:
    - extract_sign_exponent_mantissa
    - compute_E = e32 - 127
    - compute_e8 = E + 7
    - handle_overflow_to_inf
    - handle_underflow_to_subnormal_or_zero
    - round_mantissa_to_4_bits_ties_to_even
  to_f32_steps:
    - decode_fields
    - handle_zero_subnormal_inf_nan
    - compute_E = e8 - 7
    - compute_e32 = E + 127
    - build_f32_bits

ops:
  add:
    inputs: [GF8, GF8]
    output: GF8
    intermediate_type: f32
    algorithm: decode_f32_add_reencode
    rounding: ties-to-even
    commutative: true
    associative_approx: true

  sub:
    inputs: [GF8, GF8]
    output: GF8
    intermediate_type: f32
    algorithm: decode_f32_sub_reencode
    rounding: ties-to-even
    commutative: false

  mul:
    inputs: [GF8, GF8]
    output: GF8
    intermediate_type: f32
    algorithm: decode_f32_mul_reencode
    rounding: ties-to-even
    commutative: true
    associative_approx: true

  div:
    inputs: [GF8, GF8]
    output: GF8
    intermediate_type: f32
    algorithm: decode_f32_div_reencode
    rounding: ties-to-even
    commutative: false

  fma:
    inputs: [GF8, GF8, GF8]
    output: GF8
    intermediate_type: f32
    algorithm: fused_multiply_add
    single_rounding: true
    commutative: false

  sqrt:
    inputs: [GF8]
    output: GF8
    intermediate_type: f32
    algorithm: decode_f32_sqrt_reencode
    rounding: ties-to-even

  abs:
    inputs: [GF8]
    output: GF8
    algorithm: sign_mask
    commutative: true

  neg:
    inputs: [GF8]
    output: GF8
    algorithm: sign_flip
    commutative: false

  cmp:
    inputs: [GF8, GF8]
    outputs: [lt, eq, gt, ne, le, ge]
    intermediate_type: f32
    algorithm: decode_f32_compare

test_vectors:
  - name: zero
    f32: 0.0
    raw_hex: "00"
  - name: one
    f32: 1.0
    raw_hex: "78"
  - name: minus_one
    f32: -1.0
    raw_hex: "F8"
  - name: pi
    f32: 3.1415927
    raw_hex: "C4"
  - name: max_pos
    f32: 6.0
    raw_hex: "7F"
